# Copiar a .env y ajustar para el entorno local.

# Postgres (coincide con docker-compose.yml)
DATABASE_URL="postgresql://pmd_user:pmd_password@localhost:5432/pmd_control_hub?schema=public"
# Conexión directa, usada solo por las migraciones. En Postgres local es la
# misma; en Neon es la cadena SIN "-pooler" en el host.
DIRECT_URL="postgresql://pmd_user:pmd_password@localhost:5432/pmd_control_hub?schema=public"

# Sesión / auth
SESSION_SECRET="change-me-to-a-long-random-string"

# Puerto de la app dentro del contenedor
PORT=3000

# Modo de un solo usuario: sin login ni permisos. Cualquiera que llegue a la
# URL entra y puede modificar datos — no usarlo en un despliegue público sin
# algo delante. Quitar la variable (o ponerla en false) reactiva el login.
AUTH_DISABLED=true
